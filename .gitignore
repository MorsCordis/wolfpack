# Wolfpack — hunt artifacts (local, copied back by /merge)
.wolfpack/plans/*/
!.wolfpack/plans/*/pedigree.json

# Wolfpack — worktrees
# Both namespaces: canonical creates them under .agents/, a Claude Code
# consuming project under .claude/. Ignoring only one leaves a whole worktree
# showing as untracked and trips /merge's dirty-state check.
.agents/worktrees/
.claude/worktrees/

# Wolfpack — campaigns (local planning artifacts)
.wolfpack/campaigns/

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~

# Claude Code's synced skills store — the HARNESS owns it (~/.claude/skills symlinks to
# this repo's .agents/skills, so synced anthropic-skills land here). Never delete or track it.
.agents/skills/synced/

# Wolfpack — generated workflow copies are never tracked, in any repo (install.sh writes them and
# the run start refuses a stale one). In the pack itself .claude/workflows is the tracked link to
# the canonical .agents/workflows, so nothing is generated here; the lines keep the rule identical.
.claude/workflows/hunt-pipeline.js
.claude/workflows/campaign-runner.js
